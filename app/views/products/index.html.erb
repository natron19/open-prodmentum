<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">My Products</h1>
  <%= link_to "New Product", new_product_path, class: "btn btn-cta" %>
</div>

<% if @products.any? %>
  <div class="row g-3">
    <% @products.each do |product| %>
      <div class="col-md-6">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title fw-semibold"><%= product.name %></h5>
            <p class="card-text text-muted small mb-1">
              <strong>Customer:</strong> <%= product.target_customer %>
            </p>
            <p class="card-text text-muted small mb-3">
              <strong>Goal:</strong> <%= truncate(product.strategic_goal, length: 100) %>
            </p>

            <div class="d-flex gap-1 mb-2">
              <% product.discovery_steps.order(:step_number).each do |step| %>
                <span class="<%= step.completed? ? 'step-complete-badge' : 'text-muted' %>"
                      title="<%= step.step_name %>">&#9679;</span>
              <% end %>
            </div>

            <% completed_count = product.discovery_steps.count(&:completed?) %>
            <p class="text-muted small mb-3"><%= completed_count %> of 5 steps complete</p>

            <%= link_to completed_count > 0 ? "Continue Discovery" : "Start Discovery",
                  product_path(product), class: "btn btn-sm btn-cta" %>

            <div class="float-end">
              <%= link_to "Edit", edit_product_path(product), class: "btn btn-sm btn-outline-secondary me-1" %>
              <%= link_to "Delete", product_path(product),
                    data: { turbo_method: :delete, turbo_confirm: "Delete this product and all its steps?" },
                    class: "btn btn-sm btn-outline-danger" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="card">
    <div class="card-body text-center py-5">
      <p class="text-muted mb-3">You haven't started a product discovery yet.</p>
      <%= link_to "Start your first discovery", new_product_path, class: "btn btn-cta" %>
    </div>
  </div>
<% end %>

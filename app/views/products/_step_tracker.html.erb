<div id="step_tracker" data-controller="step-tracker">
  <% first_incomplete = steps.find { |s| !s.completed? } %>

  <div class="list-group list-group-flush">
    <% steps.each do |step| %>
      <% is_active  = step == active_step %>
      <% is_locked  = first_incomplete && step.step_number > first_incomplete.step_number %>

      <% if is_locked %>
        <div class="list-group-item step-locked">
          <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-circle bg-secondary" style="width:1.6rem;height:1.6rem;line-height:1.3;">
              <%= step.step_number %>
            </span>
            <span class="small text-muted"><%= step.step_name %></span>
          </div>
        </div>
      <% else %>
        <%= link_to product_step_path(product, step),
              data: { turbo_frame: :step_content,
                      action: "click->step-tracker#activate",
                      step_tracker_target: "item" },
              class: "list-group-item list-group-item-action #{"active" if is_active}" do %>
          <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-circle #{ step.completed? ? "" : "bg-secondary" }"
                  style="<%= step.completed? ? "background-color: var(--accent); width:1.6rem;height:1.6rem;line-height:1.3;" : "width:1.6rem;height:1.6rem;line-height:1.3;" %>">
              <%= step.step_number %>
            </span>
            <div class="flex-grow-1">
              <div class="d-flex align-items-center gap-1">
                <span class="small fw-semibold"><%= step.step_name %></span>
                <% if step.completed? %>
                  <i class="bi bi-check-circle-fill step-complete-badge small"></i>
                <% end %>
              </div>
              <% if step.completed? && step.gemini_output.present? %>
                <div class="text-muted" style="font-size:0.7rem;line-height:1.3;">
                  <%= truncate(step.gemini_output.gsub(/[#*`]/, ""), length: 70) %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

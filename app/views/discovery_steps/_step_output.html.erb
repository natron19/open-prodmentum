<div class="mb-3">
  <%= render_markdown(step.gemini_output) %>
</div>

<% if step.step_number == 5 %>
  <p class="text-muted small mt-2">
    This is an AI-assisted starting point. Your discovery data and judgment should drive the final call.
  </p>
<% end %>

<div class="mb-3">
  <a class="btn btn-link btn-sm text-muted p-0" data-bs-toggle="collapse"
     href="#raw-response-<%= step.id %>" role="button">
    Show raw response
  </a>
  <div class="collapse mt-2" id="raw-response-<%= step.id %>">
    <pre class="text-muted small border rounded p-2"><%= step.gemini_raw %></pre>
  </div>
</div>

<div class="d-flex gap-2">
  <%= link_to "Regenerate",
        edit_product_step_path(step.product, step),
        class: "btn btn-outline-primary btn-sm",
        data: { turbo_frame: :step_content } %>

  <% if step.step_number < 5 %>
    <% next_step = step.product.discovery_steps.find_by(step_number: step.step_number + 1) %>
    <% if next_step %>
      <%= link_to "Continue to Next Step",
            product_step_path(step.product, next_step),
            class: "btn btn-cta btn-sm",
            data: { turbo_frame: :step_content } %>
    <% end %>
  <% end %>
</div>
